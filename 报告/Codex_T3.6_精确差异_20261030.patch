+  if (fail) process.exitCode = 1;
+}
+run().catch(function (err) { console.error(err.stack || err); process.exitCode = 1; });
diff --git a/docs/RETENTION_T36_DESIGN_20261030.md b/docs/RETENTION_T36_DESIGN_20261030.md
