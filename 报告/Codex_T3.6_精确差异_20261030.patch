+  h.setFail({ collection: 'upload_logs', op: 'add', atCall: 2 });
+  const deferredMark = await T.recoverPending({ now: now });
+  h.clearFail();
+  check('C11 标记审计退避更新旧 rev 条件并递增新 rev',
