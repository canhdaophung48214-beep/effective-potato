+      eventId: eventId('retry-record', 2), day: '2026-10-30', retryAfter: new Date(0) } } });
+  h.setFail({ collection: 'upload_logs', op: 'add', atCall: 1 });
+  const failedWrite = await T.recoverAudit('retry-record');
+  h.clearFail();
