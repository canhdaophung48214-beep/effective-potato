.card{min-width:0;overflow:hidden;border-radius:26rpx;background:#fff;box-shadow:0 10rpx 30rpx rgba(40,68,35,.1);border:1rpx solid #ebeee7}.visual{height:190rpx;display:flex;align-items:flex-end;padding:20rpx;background:linear-gradient(145deg,#dcecc8,#f8dba9);color:#295d25;font-size:24rpx;font-weight:700}.body{padding:22rpx}.name{min-height:74rpx;font-size:30rpx;font-weight:760;line-height:1.25}.history{margin-top:10rpx;color:#d75b24;font-size:27rpx;font-weight:700}.compact .visual{height:132rpx}.compact .body{padding:18rpx}.compact .name{min-height:0;font-size:27rpx}.compact .history{font-size:24rpx}
