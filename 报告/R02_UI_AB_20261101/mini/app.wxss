page{--green:#2f7d24;--green-dark:#123f1c;--green-soft:#e9f3df;--orange:#ed6a28;--ink:#172018;--muted:#687068;--paper:#f7f8f2;--card:#fff;box-sizing:border-box;background:var(--paper);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC",sans-serif}view,text,input,button{box-sizing:border-box}.page{min-height:100vh;padding:0 24rpx 160rpx}.safe-top{height:88rpx}.topbar{display:flex;align-items:center;justify-content:space-between;min-height:88rpx}.brand{font-size:52rpx;font-weight:800;letter-spacing:-3rpx;color:var(--green-dark)}.subtitle{margin-top:4rpx;color:#485447;font-size:26rpx}.section-head{display:flex;align-items:center;justify-content:space-between;margin:34rpx 4rpx 20rpx}.section-title{font-size:34rpx;font-weight:750}.section-link{min-height:88rpx;display:flex;align-items:center;font-size:24rpx;color:var(--muted)}.pill{min-height:88rpx;padding:0 24rpx;border-radius:999rpx;background:#fff;border:1rpx solid #e1e5dc;color:#3f493f;font-size:25rpx}.pill.active{background:var(--green);border-color:var(--green);color:#fff}.status-unknown{color:#8a5b1e;background:#fff2d9}.long-text{white-space:normal;word-break:break-word;overflow-wrap:anywhere}.empty{padding:90rpx 32rpx;text-align:center;background:#fff;border-radius:28rpx;color:var(--muted)}.empty-title{font-size:32rpx;font-weight:700;color:var(--ink);margin-bottom:14rpx}.fixed-actions{position:fixed;z-index:10;left:0;right:0;bottom:0;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));display:flex;gap:16rpx;background:rgba(255,255,255,.96);border-top:1rpx solid #e9ece5}.button{flex:1;min-height:88rpx;border:0;border-radius:999rpx;font-size:28rpx;font-weight:700;line-height:88rpx;padding:0}.button.primary{background:var(--green);color:#fff}.button.secondary{background:#fff;color:var(--green);border:2rpx solid var(--green)}button::after{border:0}
