.detail{min-height:100vh;padding-bottom:150rpx;background:#f7f8f2}.detail-top{height:88rpx;padding:0 26rpx;display:grid;grid-template-columns:60rpx 1fr 60rpx;align-items:center}.back{min-width:88rpx;min-height:88rpx;display:flex;align-items:center;font-size:62rpx;line-height:1}.title{text-align:center;font-size:34rpx;font-weight:750}.detail-visual{height:390rpx;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 50% 45%,#fff 0 16%,#f2b96f 17% 36%,#7aa35c 37% 39%,#e7efda 40% 65%,#d8e4c5 66%);font-size:36rpx;font-weight:800;color:#214d20}.detail-body{margin-top:-24rpx;padding:34rpx 26rpx 20rpx;border-radius:32rpx 32rpx 0 0;background:#f7f8f2;position:relative}.detail-name{font-size:48rpx;font-weight:820;line-height:1.2}.historical-price{margin:14rpx 0 20rpx;color:#d75b24;font-size:34rpx;font-weight:750}.info-card{margin-top:20rpx;padding:24rpx;border-radius:24rpx;background:#fff}.info-title{font-size:29rpx;font-weight:750;color:#2e5429}.info-copy{margin-top:12rpx;font-size:25rpx;line-height:1.7;color:#414b41}.info-row{display:grid;grid-template-columns:90rpx minmax(0,1fr);gap:18rpx;margin-top:16rpx;font-size:25rpx;line-height:1.6}.info-row text:first-child{color:#778077}
