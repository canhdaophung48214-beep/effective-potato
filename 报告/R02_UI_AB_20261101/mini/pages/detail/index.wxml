<view class="detail" wx:if="{{item}}"><view class="safe-top"></view><view class="detail-top"><text class="back" bindtap="back">‹</text><text class="title">菜品详情</text><text class="spacer"></text></view><view class="detail-visual"><text>{{item.preparation}}</text></view><view class="detail-body"><view class="detail-name long-text">{{item.name}}</view><view class="historical-price">{{item.historicalPriceText}}</view><history-notice /><view class="info-card"><view class="info-title">基础信息</view><view class="info-row"><text>楼层</text><text class="long-text">{{item.floorText}}</text></view><view class="info-row"><text>窗口</text><text>{{item.windowText}}</text></view><view class="info-row"><text>口味</text><text>{{item.tasteText}}</text></view></view><view class="info-card"><view class="info-title">来源说明</view><view class="info-copy long-text">{{item.sourceText}}</view></view><view class="info-card"><view class="info-title">档口状态</view><view class="info-copy long-text">{{item.parentNotice}}</view></view><view class="info-card"><view class="info-title">历史价格说明</view><view class="info-copy long-text">{{item.historyNotice}}</view></view></view><view class="fixed-actions"><button class="button secondary" bindtap="another">再看一条</button><button class="button primary" bindtap="openList">查看全部记录</button></view></view>
