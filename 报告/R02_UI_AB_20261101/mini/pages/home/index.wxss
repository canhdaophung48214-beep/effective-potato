.mark{width:72rpx;height:72rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#e8f2dc;color:#2f7d24;font-weight:800}.hero{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(190rpx,.85fr);gap:18rpx;margin:22rpx 0;padding:28rpx;border-radius:32rpx;background:linear-gradient(135deg,#fff0cd,#deefc9);overflow:hidden}.eyebrow{font-size:25rpx;color:#52634d}.hero-name{margin-top:12rpx;font-size:40rpx;font-weight:800;line-height:1.2}.hero-history{margin-top:16rpx;color:#d75b24;font-weight:700}.hero-buttons{display:flex;gap:12rpx;margin-top:24rpx}.hero-buttons .button{min-height:88rpx;font-size:24rpx;line-height:88rpx}.hero-visual{min-width:0;display:flex;align-items:center;justify-content:center;border-radius:50% 50% 44% 44%;background:radial-gradient(circle at 50% 35%,#fff 0 24%,#efba72 25% 46%,#5d8d47 47% 49%,transparent 50%);color:#214d20;font-weight:800}.home-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx}@media(max-width:340px){.hero{grid-template-columns:1fr}.hero-visual{height:160rpx}.hero-name{font-size:36rpx}}
