.list-title{font-size:42rpx;font-weight:800}.category-row{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10rpx;margin:22rpx 0}.category-button,.sort-button,.sheet-action,.range-option{min-height:88rpx;display:flex;align-items:center;justify-content:center}.category-button{padding:0 6rpx;border-radius:18rpx;background:#fff;border:1rpx solid #e1e5dc;color:#475147;font-size:24rpx}.category-button.active{background:#2f7d24;border-color:#2f7d24;color:#fff}.filter-trigger text{margin-left:2rpx}.result-bar{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:16rpx 0}.count{color:#596359}.count text{color:#2f7d24;font-size:34rpx;font-weight:800}.sort-button{flex:none;padding:0 20rpx;border-radius:18rpx;background:#fff;border:1rpx solid #dfe4da;color:#31522e;font-size:24rpx}.menu-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx}.menu-grid dish-card{min-width:0}.filter-mask{position:fixed;z-index:20;inset:0;background:rgba(14,25,14,.38)}.filter-sheet{position:fixed;z-index:21;left:0;right:0;bottom:0;padding:18rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));border-radius:32rpx 32rpx 0 0;background:#fff;transform:translateY(105%);transition:transform .2s ease}.filter-sheet.open{transform:translateY(0)}.sheet-handle{width:76rpx;height:8rpx;margin:0 auto 22rpx;border-radius:99rpx;background:#d8ddd4}.sheet-title{font-size:34rpx;font-weight:800}.sheet-label{margin-top:28rpx;font-size:26rpx;font-weight:700;color:#536053}.range-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin-top:16rpx}.range-option{border-radius:18rpx;background:#f5f7f1;border:2rpx solid transparent;font-size:25rpx}.range-option.selected{border-color:#2f7d24;background:#edf5e7;color:#25611d;font-weight:700}.sheet-actions{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:30rpx}.sheet-action{border-radius:999rpx;font-size:28rpx;font-weight:700;line-height:88rpx}.sheet-action.reset{background:#fff;color:#2f7d24;border:2rpx solid #2f7d24}.sheet-action.confirm{background:#2f7d24;color:#fff}.sheet-action::after{border:0}@media(max-width:340px){.menu-grid{gap:14rpx}.page{padding-left:18rpx;padding-right:18rpx}.category-row{gap:6rpx}.category-button{font-size:22rpx;padding:0 2rpx}.sort-button{padding:0 12rpx;font-size:22rpx}}
