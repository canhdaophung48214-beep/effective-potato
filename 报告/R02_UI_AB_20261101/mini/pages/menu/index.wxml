<view class="page"><view class="safe-top"></view><view class="topbar"><view><view class="list-title">历史菜单</view><view class="subtitle">39 条记录，仅供查阅</view></view></view><search-bar value="{{query}}" bindinput="onInput" />
<view class="category-row"><view wx:for="{{preparations}}" wx:key="*this" class="category-button {{preparation===item?'active':''}}" data-value="{{item}}" bindtap="selectType">{{item}}</view><view class="category-button filter-trigger {{filterCount?'active':''}}" bindtap="openFilter">筛选<text wx:if="{{filterCount}}"> {{filterCount}}</text></view></view>
<history-notice compact="{{true}}" /><view class="result-bar"><view class="count">找到 <text>{{items.length}}</text> 条记录</view><view class="sort-button" bindtap="cycleSort">{{sortLabel}}⌄</view></view>
<view wx:if="{{items.length}}" class="menu-grid"><dish-card wx:for="{{items}}" wx:key="id" item="{{item}}" minimal="{{true}}" bindopen="open" /></view><view wx:else class="empty"><view class="empty-title">没有匹配的历史记录</view><view>换个菜名或重置筛选后再试</view></view></view>
<view wx:if="{{filterOpen}}" class="filter-mask" bindtap="closeFilter"></view><view class="filter-sheet {{filterOpen?'open':''}}"><view class="sheet-handle"></view><view class="sheet-title">筛选历史菜单</view><view class="sheet-label">历史金额</view><view class="range-list"><view class="range-option {{draftRange==='all'?'selected':''}}" data-value="all" bindtap="selectRange">不限</view><view class="range-option {{draftRange==='low'?'selected':''}}" data-value="low" bindtap="selectRange">10–12 元</view><view class="range-option {{draftRange==='high'?'selected':''}}" data-value="high" bindtap="selectRange">13–15 元</view></view><view class="sheet-actions"><button class="sheet-action reset" bindtap="resetFilter">重置</button><button class="sheet-action confirm" bindtap="confirmFilter">确认</button></view></view>
