.history-list{padding:28rpx;background:#f5f3ee;color:#292a26}.notice{padding:20rpx;border-left:6rpx solid #9a6a28;background:#fff3d9;margin-bottom:24rpx}.card{padding:28rpx;margin-bottom:22rpx;border-radius:16rpx;background:white}.name{font-size:34rpx;font-weight:600}.price-row{margin-top:20rpx}.label{font-size:24rpx;color:#706957;margin-right:18rpx}.history-price{font-size:36rpx;color:#7a5c30}.current{margin-top:16rpx;font-size:28rpx;color:#555}.hint{margin-top:14rpx;font-size:24rpx;color:#89521c}.source,.parent{margin-top:14rpx;font-size:22rpx;color:#777;word-break:break-all}
/* M3.4.2 narrow-screen safety: no clipping, fixed card widths or source truncation. */
.history-list,.card,.notice{box-sizing:border-box;max-width:100%;min-width:0}.name,.source,.parent,.hint,.current,.history-price{white-space:normal;word-break:break-all;overflow-wrap:anywhere}.price-row{display:flex;flex-wrap:wrap;align-items:baseline;gap:10rpx}.history-price{flex:0 1 auto}.source{line-height:1.7}
