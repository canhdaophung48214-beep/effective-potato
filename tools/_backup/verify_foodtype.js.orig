/* 主食类型筛选 —— 与全部既有条件的联动回归测试
   加载真实 pages/index/index.js，用假 Page() 捕获、假 setData 驱动，
   等于在 Node 里把「点筛选按钮」真跑一遍。 */
const path = require('path');
const fs = require('fs');

const ROOT = 'C:\\Users\\25975\\Desktop\\文件all\\微信小程序';
const { ALL_DISHES, ALL_SHOPS, FOOD_TYPE_LABEL } = require(path.join(ROOT, 'data/index.js'));
const { SHOPS } = require(path.join(ROOT, 'data/shops.js'));
const { DISHES } = require(path.join(ROOT, 'data/dishes.js'));
const { filterDishes, collectShopIds } = require(path.join(ROOT, 'utils/matcher.js'));

let fail = 0;
function check(ok, label, extra) {
  if (ok) console.log('  OK  ' + label + (extra !== undefined ? '  → ' + extra : ''));
  else { fail++; console.log('  FAIL ' + label + (extra !== undefined ? '  → ' + extra : '')); }
}

/* ================= 载入页面并造实例 ================= */
let captured = null;
global.Page = function (obj) { captured = obj; };
global.wx = { showToast: function () {} };
require(path.join(ROOT, 'pages/index/index.js'));

function newPage() {
  const p = Object.assign({}, captured);
  p.data = JSON.parse(JSON.stringify(captured.data));
  p.setData = function (patch, cb) {
    Object.assign(this.data, patch);
    if (typeof cb === 'function') cb();
  };
  p.onLoad();
  return p;
}
function tap(fn, value) {
  return function (page) { page[fn]({ currentTarget: { dataset: { value: value } } }); };
}
const RAW_SHOP_MAP = {};
SHOPS.forEach(function (s) { RAW_SHOP_MAP[s.id] = s; });

/* 独立实现：绕开 data/index.js 和 matcher.js，直接从原始数据算期望值 */
function expected(cond) {
  const out = [];
  DISHES.forEach(function (d) {
    const shop = RAW_SHOP_MAP[d.shopId];
    if (!shop) return;
    if (cond.area !== 'all' && shop.area !== cond.area) return;
    if (cond.shopId !== 'all' && d.shopId !== cond.shopId) return;
    let floorId = '';
    (shop.stalls || []).forEach(function (st) {
      if (st.id === d.stallId) floorId = st.floorId || '';
    });
    if (cond.floorId !== 'all' && floorId !== cond.floorId) return;
    if (cond.stallId !== 'all' && d.stallId !== cond.stallId) return;
    if (cond.foodType !== 'all' && d.foodType !== cond.foodType) return;
    if (cond.budget !== 0 && d.price > cond.budget) return;
    if (cond.taste !== 'all' && (d.tastes || []).indexOf(cond.taste) === -1) return;
    out.push(d);
  });
  return out;
}

console.log('=== 1. foodType 数据合法性 ===');
check(ALL_DISHES.length === 44, '菜品共 44 道', ALL_DISHES.length);
const ENUM = Object.keys(FOOD_TYPE_LABEL);
check(ENUM.length === 8, '枚举 8 个具体类型（不含 all）', ENUM.join(','));
check(ENUM.indexOf('all') === -1, "枚举里没有 'all'（'all' 只给筛选用）");

const badType = DISHES.filter(function (d) { return ENUM.indexOf(d.foodType) === -1; });
check(badType.length === 0, '每道菜的 foodType 都是合法具体类型',
  badType.length ? badType.map(function (d) { return d.id + '=' + d.foodType; }).join(',') : '0 处非法');
const noType = DISHES.filter(function (d) { return !d.foodType; });
check(noType.length === 0, '没有漏填 foodType 的菜', noType.length + ' 道漏填');
const isAll = DISHES.filter(function (d) { return d.foodType === 'all'; });
check(isAll.length === 0, "没有任何菜品把 foodType 写成 'all'", isAll.length + ' 道');

const typeCount = {};
ALL_DISHES.forEach(function (d) { typeCount[d.foodType] = (typeCount[d.foodType] || 0) + 1; });
const emptyType = ENUM.filter(function (t) { return !typeCount[t]; });
check(emptyType.length === 0, '8 个分类每个都有菜，不存在「点了必然空」的死分类',
  ENUM.map(function (t) { return FOOD_TYPE_LABEL[t] + ':' + (typeCount[t] || 0); }).join(' '));

const badText = ALL_DISHES.filter(function (d) { return !d.foodTypeText; });
check(badText.length === 0, '每道菜都拼出了中文类型文字', badText.length + ' 条为空');
check(ALL_DISHES.filter(function (d) { return d.foodType === 'rice_noodle'; })[0].foodTypeText === '米线类',
  '米线类文字正确');
check(ALL_DISHES.filter(function (d) { return d.foodType === 'rice_vermicelli'; })[0].foodTypeText === '粉类',
  '粉类文字正确');
check(FOOD_TYPE_LABEL.rice_noodle !== FOOD_TYPE_LABEL.noodle &&
      FOOD_TYPE_LABEL.rice_noodle !== FOOD_TYPE_LABEL.rice_vermicelli,
  '米线类、面类、粉类是三个互不相同的分类');

console.log('\n=== 2. 初始状态与重置基线 ===');
let p = newPage();
check(p.data.foodType === 'all', "食品类型默认 'all'", p.data.foodType);
check(p.data.foodTypeOptions.length === 9, '筛选器 9 个选项（不限 + 8 类）', p.data.foodTypeOptions.length);
check(p.data.foodTypeOptions[0].value === 'all' && p.data.foodTypeOptions[0].label === '不限类型',
  '第一项是「不限类型」');
check(p.data.matchedCount === 44, '不限类型时命中 44 道', p.data.matchedCount);
check(p.data.conditionText === '不限区域 · 不限预算 · 不限类型 · 不限口味', '条件文案含「不限类型」',
  p.data.conditionText);

