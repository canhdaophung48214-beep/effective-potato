console.log('\n=== 5. 全组合枚举（含主食类型）交叉校验 ===');
function buildLegalCombos() {
  const combos = [];
  ['all', 'campus', 'offsite'].forEach(function (area) {
    const shopsOfArea = area === 'all' ? [] : SHOPS.filter(function (s) { return s.area === area; });
    const shopChoices = area === 'all' ? ['all'] : ['all'].concat(shopsOfArea.map(function (s) { return s.id; }));
    shopChoices.forEach(function (shopId) {
      const shop = shopId === 'all' ? null : RAW_SHOP_MAP[shopId];
      const floors = shop ? (shop.floors || []) : [];
      const floorChoices = shopId === 'all' ? ['all']
        : ['all'].concat(floors.map(function (f) { return f.id; }));
      floorChoices.forEach(function (floorId) {
        const stalls = shop ? (shop.stalls || []) : [];
        const stallPool = stalls.filter(function (st) {
          return floorId === 'all' || st.floorId === floorId;
        });
        ['all'].concat(stallPool.map(function (st) { return st.id; })).forEach(function (stallId) {
          [0, 10, 15, 20].forEach(function (budget) {
            ['all', 'rice', 'noodle', 'rice_noodle', 'rice_vermicelli', 'dumpling', 'malatang', 'snack', 'other'].forEach(function (foodType) {
              ['all', 'light', 'mild_spicy', 'spicy'].forEach(function (taste) {
                combos.push({ area: area, shopId: shopId, floorId: floorId, stallId: stallId, budget: budget, foodType: foodType, taste: taste });
              });
            });
          });
        });
      });
    });
  });
  return combos;
}

const combos = buildLegalCombos();
let mismatch = 0, sample = [];
combos.forEach(function (c) {
  const got = filterDishes(ALL_DISHES, c).length;
  const exp = expected(c).length;
  if (got !== exp) {
    mismatch++;
    if (sample.length < 4) sample.push(JSON.stringify(c) + ' got=' + got + ' exp=' + exp);
  }
});
check(mismatch === 0, combos.length + ' 种全条件组合与独立实现完全一致',
  mismatch ? sample.join(' | ') : '0 处不一致');

/* 抽样用真实点击复现 */
let pageMismatch = 0, used = 0;
combos.filter(function (_, i) { return i % 211 === 0; }).slice(0, 40).forEach(function (c) {
  used++;
  const page = newPage();
  if (c.area !== 'all') tap('onSelectArea', c.area)(page);
  if (c.shopId !== 'all') tap('onSelectShop', c.shopId)(page);
  if (c.floorId !== 'all') tap('onSelectFloor', c.floorId)(page);
  if (c.stallId !== 'all') tap('onSelectStall', c.stallId)(page);
  if (c.budget !== 0) tap('onSelectBudget', c.budget)(page);
  if (c.foodType !== 'all') tap('onSelectFoodType', c.foodType)(page);
  if (c.taste !== 'all') tap('onSelectTaste', c.taste)(page);
  if (page.data.matchedCount !== expected(c).length) pageMismatch++;
});
check(pageMismatch === 0, '抽样 ' + used + ' 组用「点按钮」路径复现一致', pageMismatch + ' 处不一致');

/* 只看地点三级 + 主食类型，不含预算口味的常规查询是否都有结果 */
let deadCombo = 0;
['all', 'campus', 'offsite'].forEach(function (area) {
  ['all', 'rice', 'noodle', 'rice_noodle', 'rice_vermicelli', 'dumpling', 'malatang', 'snack', 'other'].forEach(function (ft) {
    const n = expected({ area: area, shopId: 'all', floorId: 'all', stallId: 'all', budget: 0, foodType: ft, taste: 'all' }).length;
    if (n === 0) deadCombo++;
  });
});
check(deadCombo === 0, '「区域 × 主食类型」27 种组合全部有结果，不会出现死分类', deadCombo + ' 个空');

console.log('\n=== 6. 三个推荐模式在米线条件下都只出米线 ===');
p = newPage();
tap('onSelectFoodType', 'rice_noodle')(p);
p.onViewAll();
check(p.data.listDishes.every(function (d) { return d.foodType === 'rice_noodle'; }), '查看全部：全是米线');
p.onRandomDish();
check(p.data.pickedDish.foodType === 'rice_noodle', '随机选一道菜：是米线',
  p.data.pickedDish.name);
p.onRandomShop();
check(p.data.pickedShop.dishes.every(function (d) { return d.foodType === 'rice_noodle'; }),
  '随机选一家：店内菜品全是米线');

console.log('\n=== 7. WXML / WXSS / JS 三方对齐 ===');
const wxml = fs.readFileSync(path.join(ROOT, 'pages/index/index.wxml'), 'utf8');
const wxss = fs.readFileSync(path.join(ROOT, 'pages/index/index.wxss'), 'utf8');
const js = fs.readFileSync(path.join(ROOT, 'pages/index/index.js'), 'utf8');

const usedCls = new Set();
(wxml.match(/class="([^"]*)"/g) || []).forEach(function (a) {
  let v = a.slice(7, -1).replace(/\{\{([\s\S]*?)\}\}/g, function (_m, inner) {
    const q = inner.match(/[?:]\s*'([^']*)'/g) || [];
    return ' ' + q.map(function (s) { return s.replace(/^[?:]\s*'/, '').replace(/'$/, ''); }).join(' ') + ' ';
  });
  v.split(/\s+/).forEach(function (t) { if (t && !/^[0-9.]+$/.test(t)) usedCls.add(t); });
});
const definedCls = new Set();
(wxss.match(/\.([a-zA-Z][a-zA-Z0-9_-]*)/g) || []).forEach(function (s) { definedCls.add(s.slice(1)); });
const missing = Array.from(usedCls).filter(function (c) { return !definedCls.has(c); });
check(missing.length === 0, 'WXML 的 ' + usedCls.size + ' 个 class 都有样式',
  missing.length ? '缺失: ' + missing.join(',') : '无缺失');
check(definedCls.has('type-scroll') && definedCls.has('tag-type') && definedCls.has('label-tip'),
  '本次新增的 type-scroll / tag-type / label-tip 样式都在');

const handlers = Array.from(new Set((wxml.match(/bindtap="([a-zA-Z]+)"/g) || [])
  .map(function (s) { return s.replace(/bindtap="|"/g, ''); })));
handlers.forEach(function (h) {
  check(js.indexOf(h + '(') !== -1, 'WXML 调用的 ' + h + ' 在 JS 中已实现');
});
check(handlers.length === 11, '共 11 个不同的点击处理函数', handlers.length);
check(handlers.indexOf('onSelectFoodType') !== -1, '主食类型有独立处理函数 onSelectFoodType');

check(wxml.indexOf('scroll-view class="type-scroll"') !== -1, '主食类型用横向 scroll-view 承载');
check((wxml.match(/<template is="dishCard"/g) || []).length === 3, 'dishCard 模板仍复用 3 次');
check(wxml.indexOf('{{dish.foodTypeText}}') !== -1, '菜品卡展示了主食类型');
check(wxml.indexOf('演示数据') !== -1 && wxml.indexOf('虚构演示数据') !== -1, '演示数据标记仍在');

console.log('\n================================');
if (fail === 0) console.log('全部检查通过 ✅');
else { console.log('有 ' + fail + ' 项未通过 ❌'); process.exitCode = 1; }
