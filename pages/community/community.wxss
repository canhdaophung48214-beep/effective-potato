/* ===================================================================
   社区页样式 —— 校园餐饮信息板（灶火纸感）
   颜色写成固定值，不使用 CSS 变量
   =================================================================== */

.page {
  padding: 0 32rpx 48rpx;
}

/* ---------------- 标题 ---------------- */
.hero {
  padding: 32rpx 8rpx 24rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #241E1A;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #9C9289;
}

/* ---------------- 能力边界提示 ---------------- */
.banner {
  margin-top: 8rpx;
  padding: 24rpx 26rpx;
  background: #FFF4E3;
  border: 1rpx solid #F4E2C4;
  border-radius: 24rpx;
}

.banner-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #A66A12;
}

.banner-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #9A7B44;
}

/* ---------------- 信息类型卡 ---------------- */
.section-card {
  margin-top: 20rpx;
  padding: 26rpx 26rpx 22rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDE4D9;
  border-radius: 28rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
}

.section-index {
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 52rpx;
  margin-right: 18rpx;
  border-radius: 16rpx;
  background: #FDECE7;
  color: #D9412B;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 52rpx;
  text-align: center;
}

.section-titles {
  flex: 1;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #241E1A;
}

.section-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6F655D;
}

.section-foot {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F5EFE7;
  display: flex;
  align-items: center;
}

.section-hint {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.5;
  color: #9C9289;
}

.section-empty {
  flex: 0 0 auto;
  margin-left: 16rpx;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #F5F1EB;
  color: #9C9289;
  font-size: 21rpx;
  line-height: 40rpx;
}

/* ---------------- 脚注 ---------------- */
.note {
  margin-top: 24rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #9C9289;
}
