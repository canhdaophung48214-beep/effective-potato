<!-- 社区栏：校园餐饮信息板（不是社交软件），当前无审核与发布能力 -->
<view class="page">

  <view class="hero">
    <view class="hero-title">校园餐饮信息板</view>
    <view class="hero-sub">只记录能核实的信息，不做社交动态</view>
  </view>

  <!-- 明确的能力边界，避免误以为可以发布 -->
  <view class="banner">
    <text class="banner-title">发布与审核尚未开放</text>
    <text class="banner-desc">当前没有任何投稿入口，页面内容为空；下面的卡片只是「将来会收哪些信息」的说明。</text>
  </view>

  <view class="section-card" wx:for="{{sections}}" wx:key="key">
    <view class="section-head">
      <view class="section-index">{{index + 1}}</view>
      <view class="section-titles">
        <view class="section-title">{{item.title}}</view>
        <view class="section-desc">{{item.desc}}</view>
      </view>
    </view>
    <view class="section-foot">
      <text class="section-hint">{{item.hint}}</text>
      <text class="section-empty">暂无已审核内容</text>
    </view>
  </view>

  <view class="note">
    本页不展示头像、点赞数、评论数或关注关系；接入审核与内容安全之后，才会开放提交入口。
  </view>

</view>
