.page {
  padding: 24rpx 24rpx 48rpx;
}

.hero {
  padding: 8rpx 8rpx 24rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #241E1A;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #9C9289;
}

.loading {
  padding: 48rpx 0;
  text-align: center;
  color: #9C9289;
  font-size: 26rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.denied {
  margin-top: 120rpx;
  text-align: center;
}

.denied-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #241E1A;
}

.denied-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #9C9289;
  line-height: 1.6;
}

.empty {
  padding: 64rpx 0;
  text-align: center;
  color: #9C9289;
  font-size: 26rpx;
}

.item-head {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #9C9289;
}

.kind {
  color: #D9412B;
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.rev {
  margin-right: 16rpx;
}

.security-pass {
  color: #2F6B3A;
}

.security-review {
  color: #B26A00;
}

.security-risk,
.security-error {
  color: #B3321F;
}

.target {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6B625B;
}

.line {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #241E1A;
}

.note {
  margin-top: 12rpx;
  padding: 16rpx;
  background: #FAF6F0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #241E1A;
  line-height: 1.6;
}

.actions {
  display: flex;
  margin-top: 24rpx;
}

.btn {
  flex: 1;
  font-size: 26rpx;
  border-radius: 999rpx;
  margin: 0 8rpx;
}

.approve {
  background: #D9412B;
  color: #FFFFFF;
}

.reject {
  background: #F0EAE3;
  color: #6B625B;
}

.message {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #FBECE9;
  color: #B3321F;
  font-size: 26rpx;
}
