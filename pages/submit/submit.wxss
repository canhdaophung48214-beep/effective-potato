.page {
  padding: 24rpx 24rpx 48rpx;
}

.hero {
  padding: 8rpx 8rpx 24rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #241E1A;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #9C9289;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0EAE3;
}

.row-column {
  display: block;
}

.label {
  width: 160rpx;
  flex: 0 0 160rpx;
  color: #6B625B;
  font-size: 26rpx;
}

.picker,
.input {
  flex: 1;
  font-size: 28rpx;
  color: #241E1A;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  margin-top: 12rpx;
  font-size: 28rpx;
}

.counter {
  text-align: right;
  font-size: 22rpx;
  color: #9C9289;
}

.submit {
  margin-top: 32rpx;
  background: #D9412B;
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.tip {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #9C9289;
  line-height: 1.6;
}

.done-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #D9412B;
}

.done-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6B625B;
  line-height: 1.6;
}

.message {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.message.error {
  background: #FBECE9;
  color: #B3321F;
}

.message.ok {
  background: #EAF3EA;
  color: #2F6B3A;
}
