<!-- ===================================================================
     菜品卡片模板：三处复用（随机选一家的店内菜品 / 随机选一道菜 / 查看全部）
     调用写法见文件后半段，形如  template is="dishCard" data="{{dish: item}}"
     =================================================================== -->
<template name="dishCard">
  <view class="dish-card">
    <view class="dish-left">
      <view class="dish-name">{{dish.name}}</view>
      <!-- stallLabel：已核实编号显示「N 号窗口」，没有编号就显示店铺名 -->
      <view class="dish-shop">{{dish.shopName}} · {{dish.stallLabel}}</view>
      <view class="dish-loc">{{dish.location}}</view>
      <view class="dish-tags">
        <!-- 第一个标签由数据决定：演示信息 / 待核实 / 已核实 / 核实已过期。
             它取的是「菜品 + 窗口 + 楼层 + 店铺」四层里最弱的那一层 -->
        <text class="tag tag-v {{dish.verifyClass}}">{{dish.verifyText}}</text>
        <text class="tag tag-type">{{dish.foodTypeText}}</text>
        <text class="tag tag-area">{{dish.areaText}}</text>
        <text class="tag tag-taste">{{dish.tasteText}}</text>
      </view>
    </view>
    <view class="dish-right">
      <view class="dish-price"><text class="price-unit">¥</text>{{dish.price}}</view>
      <!-- 纠错入口：只带真实编号；演示数据进去后由投稿页明确拒绝 -->
      <view class="dish-fix"
            data-shop-id="{{dish.shopId}}"
            data-stall-id="{{dish.stallId}}"
            data-dish-id="{{dish.id}}"
            bindtap="onSubmitDish"
            hover-class="tap-hover">纠错</view>
    </view>
  </view>
</template>


<view class="page">

  <!-- ==================== 页面标题 ==================== -->
  <view class="hero">
    <view class="hero-title">吃什么</view>
    <view class="hero-sub"> 今天吃点什么好</view>
    <!-- 数据来源标签：加载完成后才出现，必须让用户一眼分清真实 / 演示 / 未知 -->
    <block wx:if="{{dataState === 'ready'}}">
      <view class="demo-badge demo-badge-real" wx:if="{{dataSource === 'cloud'}}">真实试点数据 · 全部待核实</view>
      <view class="demo-badge" wx:elif="{{dataSource === 'local'}}">演示数据 · 不对应任何真实商家</view>
      <view class="demo-badge demo-badge-warn" wx:else>数据来源未知 · 请勿当作真实信息</view>
      <view class="demo-badge demo-badge-warn" wx:if="{{dataNoticeText}}">{{dataNoticeText}}</view>
    </block>
  </view>

  <!-- ==================== 加载状态 ==================== -->
  <!-- 由 page 的 dataState 真实驱动；本阶段数据源固定为本地 -->
  <view class="state-card" wx:if="{{dataState === 'loading'}}">
    <view class="state-dot"></view>
    <view class="state-title">正在准备数据…</view>
    <view class="state-desc">正在尝试读取真实数据，读不到会自动回退到演示数据</view>
  </view>

  <view class="state-card state-card-error" wx:elif="{{dataState === 'error'}}">
    <view class="state-title">数据没能加载出来</view>
    <view class="state-desc">{{dataErrorText}}</view>
    <view class="state-btn" bindtap="onRetry" hover-class="tap-hover">重试</view>
  </view>

  <!-- ==================== 筛选区 ==================== -->
  <block wx:elif="{{dataState === 'ready'}}">

  <view class="panel">

    <!-- ---------- 一级：就餐区域（单选） ---------- -->
    <view class="filter-group">
      <view class="filter-label">就餐区域</view>
      <view class="chip-row">
        <view class="chip {{area === item.value ? 'chip-on' : ''}}"
              wx:for="{{areaOptions}}"
              wx:key="value"
              data-value="{{item.value}}"
              bindtap="onSelectArea">{{item.label}}</view>
      </view>
    </view>

    <!-- ---------- 未选区域时的说明 ---------- -->
    <view class="locate-tip" wx:if="{{area === 'all'}}">
      先选「校内食堂」或「校外周边」，才会列出对应的餐厅 / 商家。
    </view>

    <!-- ---------- 二级：餐厅 / 商家（可多选，组内「或」） ---------- -->
    <view class="filter-group">
      <view class="filter-label">
        {{area === 'offsite' ? '商家' : '餐厅'}}<text class="label-tip">可多选</text>
      </view>

      <block wx:if="{{area === 'all'}}">
        <view class="filter-hint">选好就餐区域后，这里会列出可选的{{area === 'offsite' ? '商家' : '餐厅'}}。</view>
      </block>

      <block wx:elif="{{restaurantOptions.length}}">
        <view class="chip-row">
          <view class="chip {{item.selected ? 'chip-on' : ''}}"
                wx:for="{{restaurantOptions}}"
                wx:key="id"
                data-shop-id="{{item.id}}"
                bindtap="onToggleShop">{{item.name}}</view>
        </view>
        <view class="filter-hint">
          可以同时选多家，符合任意一家即可；每家可以单独设楼层、店铺和方位。
        </view>
      </block>

      <view class="filter-hint" wx:else>该区域暂无可选餐厅。</view>
    </view>

    <!-- ---------- 三级：每家餐厅各自的位置配置（默认折叠） ----------
         楼层 / 店铺 / 方位三组都是多选，组内「或」、组间「与」，
         不同餐厅之间互不影响。数据里没有的楼层、编号、方位一律不出现。 -->
    <view class="shop-config" wx:for="{{shopViews}}" wx:key="id">

      <!-- 折叠头：点标题展开 / 收起 -->
      <view class="shop-config-head"
            data-shop-id="{{item.id}}"
            bindtap="onToggleShopConfig"
            hover-class="tap-hover">
        <view class="shop-config-title">
          <text class="shop-config-name">{{item.name}}</text>
          <text class="shop-config-sum">{{item.summary}}</text>
        </view>
        <text class="shop-config-toggle">{{item.expanded ? '收起' : '设置'}}</text>
      </view>

      <view class="shop-config-body" wx:if="{{item.expanded}}">

        <!-- 楼层组：该店没有楼层划分时只给一句说明 -->
        <block wx:if="{{item.floorChips.length}}">
          <view class="sub-label">楼层<text class="label-tip">可多选</text></view>
          <view class="chip-row">
            <view class="chip sub-chip {{opt.on ? 'chip-on' : ''}}"
                  wx:for="{{item.floorChips}}"
                  wx:for-item="opt"
                  wx:key="id"
                  data-shop-id="{{item.id}}"
                  data-value="{{opt.id}}"
                  bindtap="onToggleFloor">{{opt.label}}</view>
          </view>
        </block>
        <view class="filter-hint" wx:else>{{item.floorHint}}</view>

        <!-- 店铺 / 位置组：按已选楼层收敛，没有编号就只显示店名 -->
        <block wx:if="{{item.stallChips.length}}">
          <view class="sub-label">店铺 / 位置<text class="label-tip">可多选</text></view>
          <view class="chip-row">
            <view class="chip sub-chip {{opt.on ? 'chip-on' : ''}}"
                  wx:for="{{item.stallChips}}"
                  wx:for-item="opt"
                  wx:key="id"
                  data-shop-id="{{item.id}}"
                  data-value="{{opt.id}}"
                  bindtap="onToggleStall">{{opt.label}}</view>
          </view>
        </block>
        <view class="filter-hint" wx:if="{{item.stallHint}}">{{item.stallHint}}</view>

        <!-- 方位组：该店数据里没有任何方位时，这一整块不渲染 -->
        <block wx:if="{{item.hasSide}}">
          <view class="sub-label">方位<text class="label-tip">可多选</text></view>
          <view class="chip-row">
            <view class="chip sub-chip {{opt.on ? 'chip-on' : ''}}"
                  wx:for="{{item.sideChips}}"
                  wx:for-item="opt"
                  wx:key="value"
                  data-shop-id="{{item.id}}"
                  data-value="{{opt.value}}"
                  bindtap="onToggleSide">{{opt.label}}</view>
          </view>
        </block>

      </view>
    </view>

    <!-- ---------- 预算（单选，横向滚动；选项文字不缩） ---------- -->
    <view class="filter-group">
      <view class="filter-label">预算<text class="label-tip">横向滑动</text></view>
      <scroll-view class="type-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
        <view class="chip {{budget === item.value ? 'chip-on' : ''}}"
              wx:for="{{budgetOptions}}"
              wx:key="value"
              data-value="{{item.value}}"
              bindtap="onSelectBudget">{{item.label}}</view>
      </scroll-view>
    </view>

    <!-- ---------- 主食类型（多选，9 个选项横向一行可滑动） ---------- -->
    <view class="filter-group">
      <view class="filter-label">
        主食类型<text class="label-tip">可多选 · 横向滑动</text>
      </view>
      <scroll-view class="type-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
        <view class="chip {{opt.on ? 'chip-on' : ''}}"
              wx:for="{{foodTypeChips}}"
              wx:for-item="opt"
              wx:key="value"
              data-value="{{opt.value}}"
              bindtap="onToggleFoodType">{{opt.label}}</view>
      </scroll-view>
      <view class="filter-hint">米线类与粉类分开统计，米线不算面类。</view>
    </view>

    <!-- ---------- 口味（多选） ---------- -->
    <view class="filter-group">
      <view class="filter-label">口味<text class="label-tip">可多选</text></view>
      <view class="chip-row">
        <view class="chip {{opt.on ? 'chip-on' : ''}}"
              wx:for="{{tasteChips}}"
              wx:for-item="opt"
              wx:key="value"
              data-value="{{opt.value}}"
              bindtap="onToggleTaste">{{opt.label}}</view>
      </view>
    </view>

    <!-- 条件摘要 -->
    <view class="summary">
      <view class="summary-condition">{{conditionText}}</view>
      <view class="summary-count">
        共 <text class="count-num">{{matchedCount}}</text> 道菜 ·
        <text class="count-num">{{matchedShopCount}}</text> 家店
      </view>
    </view>

    <!-- 数据状态：全部由数据的可信度字段实算，不写死 -->
    <view class="data-status">{{dataStatusText}}</view>

    <view class="reset-btn" bindtap="onReset" hover-class="tap-hover">重置筛选条件</view>
  </view>

  <!-- ==================== 操作按钮 ==================== -->
  <view class="action-row">
    <view class="btn btn-primary" bindtap="onRandomShop" hover-class="tap-hover">随机选一家</view>
    <view class="btn btn-secondary" bindtap="onRandomDish" hover-class="tap-hover">随机选一道菜</view>
  </view>
  <view class="btn btn-ghost" bindtap="onViewAll" hover-class="tap-hover">
    查看全部符合条件的美食（{{matchedCount}}）
  </view>

  <!-- ==================== 结果区 ==================== -->

  <!-- 情况一：没有任何符合条件的菜品 -->
  <view class="empty" wx:if="{{matchedCount === 0}}">
    <view class="empty-title">没有找到符合条件的菜品</view>
    <view class="empty-desc">试试放宽预算、换一个口味或主食类型，或把餐厅 / 楼层 / 店铺改回「不限」。</view>
    <view class="empty-btn" bindtap="onReset" hover-class="tap-hover">一键重置</view>
  </view>

  <block wx:else>

    <!-- 本次结果的条件摘要：贴在结果上方，不用滚回筛选面板也知道筛了什么 -->
    <view class="result-cond" wx:if="{{mode !== 'none'}}">
      <text class="result-cond-label">本次条件</text>
      <text class="result-cond-text">{{conditionText}}</text>
    </view>

    <!-- 情况二：随机选了一家 -->
    <block wx:if="{{mode === 'shop'}}">
      <view class="section-title">为你选中这家</view>
      <view class="shop-card">
        <view class="shop-row">
          <text class="shop-name">{{pickedShop.name}}</text>
          <text class="shop-area">{{pickedShop.areaText}}</text>
        </view>
        <view class="shop-loc">{{pickedShop.location}}</view>
        <view class="shop-verify">
          <text class="tag tag-v {{pickedShop.verifyClass}}">{{pickedShop.verifyText}}</text>
          <text class="shop-verify-src">{{pickedShop.sourceDetail}}</text>
        </view>
        <view class="shop-count">这家的 {{pickedShop.dishes.length}} 道菜符合当前条件</view>
      </view>

      <!-- 对当前这一家做的二次操作：再抽一次（可能还是它）/ 换一家（一定不是它） -->
      <view class="again-row">
        <view class="btn btn-small btn-secondary" bindtap="onDrawAgain" hover-class="tap-hover">再抽一次</view>
        <view class="btn btn-small btn-secondary" bindtap="onChangeShop" hover-class="tap-hover">换一家</view>
      </view>

      <view class="section-title">这家符合条件的菜</view>
      <block wx:for="{{pickedShop.dishes}}" wx:key="id">
        <template is="dishCard" data="{{dish: item}}" />
      </block>
    </block>

    <!-- 情况三：随机选了一道菜 -->
    <block wx:elif="{{mode === 'dish'}}">
      <view class="section-title">今天吃这道</view>
      <template is="dishCard" data="{{dish: pickedDish}}" />
      <view class="again-row">
        <view class="btn btn-small btn-secondary" bindtap="onDrawAgain" hover-class="tap-hover">再抽一次</view>
        <view class="btn btn-small btn-secondary" bindtap="onReset" hover-class="tap-hover">重置条件</view>
      </view>
      <view class="tip-text">「再抽一次」允许抽回同一道；不满意可以多点几次。</view>
    </block>

    <!-- 情况四：查看全部 -->
    <block wx:elif="{{mode === 'all'}}">
      <!-- 排序：只调整展示顺序，不改变筛选结果 -->
      <view class="sort-row">
        <text class="sort-label">排序</text>
        <view class="chip {{sortMode === item.value ? 'chip-on' : ''}}"
              wx:for="{{sortOptions}}"
              wx:key="value"
              data-value="{{item.value}}"
              bindtap="onSelectSort">{{item.label}}</view>
      </view>

      <view class="section-title">全部符合条件的菜品（{{listDishes.length}} 道）</view>
      <block wx:for="{{listDishes}}" wx:key="id">
        <template is="dishCard" data="{{dish: item}}" />
      </block>
    </block>

    <!-- 情况五：还没点过按钮 -->
    <view class="tip-text tip-center" wx:else>上面的条件已生效，点任意按钮开始推荐。</view>

  </block>

  <view class="footer-note" wx:if="{{dataSource === 'cloud'}}">
    当前展示的是云开发中的真实试点数据：均未经过人工核实，标为「待核实」，不构成事实声明。
    纠错投稿只针对这些真实编号，审核通过也不会自动改变核实状态。
  </view>
  <view class="footer-note" wx:else>
    本项目为课程演示版本，全部餐厅、楼层、窗口、菜名、价格、主食分类均为虚构演示数据。
    方位与窗口编号尚未采集，相关筛选项在数据补齐前不会出现。
  </view>

  </block>

</view>
